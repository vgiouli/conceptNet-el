([l-%CE%BB%CE%AE%CE%B3%CF%89_1] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "λήγω_1")
	(%3C%3Chas_ID%3E%3E [l-%CE%BB%CE%AE%CE%B3%CF%89_1])
