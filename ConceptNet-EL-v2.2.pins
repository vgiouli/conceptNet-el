	(has_string "διαφανής_1")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%B9%CE%B1%CF%86%CE%B1%CE%BD%CE%AE%CF%82_1])
	(has_antonym [a-%CE%B1%CE%B4%CE%B9%CE%B1%CF%86%CE%B1%CE%BD%CE%AE%CF%82_1])
