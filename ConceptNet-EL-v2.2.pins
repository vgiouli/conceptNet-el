	(has_string "διαθεσιμότητα_1")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%B5%CF%83%CE%B9%CE%BC%CF%8C%CF%84%CE%B7%CF%84%CE%B1_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "το να μπορει να διατεθεί κάτι")
	(has_number [Singular])
	(is_morphologically_related_to
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%83%CE%B9%CE%BC%CE%BF%CF%82_1]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%83%CE%B9%CE%BC%CE%BF%CF%82_2]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%84%CF%89_1]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%84%CF%89_2]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%B5%CF%83%CE%B9%CE%BC%CF%8C%CF%84%CE%B7%CF%84%CE%B1_2])
	(UsageExample
		"να βελτιωθεί η ενημέρωση για τη χρησιμότητα και τη σπουδαιότητα της αιμοδοσίας για την αύξηση της διαθεσιμότητας αίματος και παραγώγων αίματος"
		"Οι δραστηριότητες συνεργασίας υπόκεινται στη διαθεσιμότητα των πόρων"
		"ο νόμος της εντροπίας μας λέει ότι η διαθεσιμότητα ωφέλιμης, δηλαδή χρησιμοποιήσιμης, ενέργειας στην Φύση πάντοτε ελαττώνεται."
		"οι δράσεις που επιτρέπουν να βελτιωθεί η διαθεσιμότητα υγιών τροφίμων και η πρόσβαση σε αυτά, καθώς και η ενημέρωση σχετικά με την υγιεινή διατροφή, αποτελούν σημαντικές συνιστώσες της πολιτικής στον τομέα της διατροφής"
		"η διαθεσιμότητα αίματος και πλάσματος προς χρήση για θεραπευτικούς σκοπούς και ως πρώτες ύλες για την παρασκευή των φαρμάκων, εξαρτάται από την προθυμία και τη γεναιοδωρία των πολιτών της Κοινότητας να δώσουν αίμα ή πλάσμα"
		"Μπορείτε να κάνετε έλεγχο για διαθεσιμότητα VDSL υπηρεσίας στην περιοχή σας"
		"Αναζήτηση διαθεσιμότητας συμβεβλημένων ιατρών ΕΟΠΥΥ - ΠΕΔΙ από την επίσημη ιστοσελίδα"))

([d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%B5%CF%83%CE%B9%CE%BC%CF%8C%CF%84%CE%B7%CF%84%CE%B1_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "διαθεσιμότητα_2")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%B5%CF%83%CE%B9%CE%BC%CF%8C%CF%84%CE%B7%CF%84%CE%B1_2])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "κατάσταση κατά την οποία εργαζομενος απομακρύνεται από την εργασια του λαμβάνοντας μειωμένες απολαβές")
	(has_number [Singular])
	(has_specific_use [Term])
	(is_morphologically_related_to
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%83%CE%B9%CE%BC%CE%BF%CF%82_1]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%83%CE%B9%CE%BC%CE%BF%CF%82_2]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%84%CF%89_1]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%AD%CF%84%CF%89_2]
		[d-%CE%B4%CE%B9%CE%B1%CE%B8%CE%B5%CF%83%CE%B9%CE%BC%CF%8C%CF%84%CE%B7%CF%84%CE%B1_1])
	(UsageExample
		"Οι επιχειρήσεις και εκμεταλλεύσεις, αν έχει περιοριστεί η οικονομική τους δραστηριότητα, μπορούν, αντί της καταγγελίας της σύμβασης εργασίας, να θέτουν εγγράφως σε διαθεσιμότητα τους μισθωτούς τους, η οποία δεν μπορεί να υπερβεί συνολικά τους τρεις (3) μήνες ετησίως"
		"Κατά τη διάρκεια της διαθεσιμότητας ο μισθωτός λαμβάνει το ήμισυ του μέσου όρου των τακτικών αποδοχών των δύο τελευταίων μηνών, υπό καθεστώς πλήρους απασχόλησης"
		"Μετά την εξάντληση του τριμήνου, προκειμένου να τεθεί εκ νέου ο ίδιος εργαζόμενος σε διαθεσιμότητα απαιτείται και η παρέλευση τουλάχιστον τριών (3) μηνών"
		"Μετά την εξάντληση του τριμήνου, προκειμένου να τεθεί εκ νέου ο ίδιος εργαζόμενος σε διαθεσιμότητα απαιτείται και η παρέλευση τουλάχιστον τριών (3) μηνών"
		"Ο δικαστής δεν μπορεί να απομακρυνθεί από τη θέση του ή να τεθεί σε διαθεσιμότητα παρά μόνον με δικαστική απόφαση."))

