	(has_string "διασπορά_1")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%B9%CE%B1%CF%83%CF%80%CE%BF%CF%81%CE%AC_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "μοίρασμα και εξάπλωση σε πολλά σημεία")
	(has_number [Singular])
	(is_morphologically_related_to
		[d-%CE%B4%CE%B9%CE%B1%CF%83%CF%80%CE%BF%CF%81%CE%AC_2]
		[d-%CE%B4%CE%B9%CE%B1%CF%83%CF%80%CE%B5%CE%AF%CF%81%CF%89])
	(UsageExample
		"Στόχος είναι η διασπορά του κινδύνου με τα νέα προϊόντα της ελληνικής αγοράς Αμοιβαίων"
		"Η ιδιαιτερότητα των Fund of Funds Α/Κ είναι ότι ο επενδυτής επιτυγχάνει τη διασπορά του χαρτοφυλακίου του και ως εκ τούτου και του κινδύνου που αναλαμβάνει, σε διαφορετικές αγορές και αμοιβαία κεφάλαια"
		"Η ισλαμικής απόκλισης τρομοκρατία (συνδεδεμένη με τη διασπορά πυρηνικών, χημικών και βιολογικών όπλων) αναβαθμίστηκε στη διεθνή ορολογία στο επίπεδο της απειλής"
		"Στην Αττική συγκεντρώθηκε περίπου ο μισός πληθυσμός της χώρας, πολύ πάνω από το μισό των πάσης φύσεως δραστηριοτήτων, με διασπορά σε όλη την έκταση του νομού των αντίστοιχων κτιριακών όγκων."
		"Καθοριστική σημασία για τον έλεγχο και την πρόληψη των λοιμώξεων έχει η λήψη μέτρων υγιεινής για την παρεμπόδιση της διασποράς των ανθεκτικών στελεχών."))

