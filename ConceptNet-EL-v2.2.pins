	(has_gender [Masculine])
	(has_gloss "αυός που δεν μπορεί να αρθρώσει λόγο εξαιτίας μεγάλης έκπληξης")
	(has_number [Singular])
	(has_synonym [e-%CE%B5%CE%BC%CE%B2%CF%81%CF%8C%CE%BD%CF%84%CE%B7%CF%84%CE%BF%CF%82])
	(instantiates [Concept-%CE%AD%CE%BA%CF%80%CE%BB%CE%B7%CE%BA%CF%84%CE%BF%CF%82])
	(UsageExample
		"Άναυδοι έμειναν όλοι, όταν άκουσαν τον ίδιο τον Γάλλο πρωθυπουργό να ταυτίζει τα ύψιστα εθνικά συμφέροντα της χώρας του με το... γιαούρτι και τα μπισκότα!"
		"Από την κατακόρυφη πτώση του Χρηματιστηρίου έμειναν άναυδοι όλοι σχεδόν οι κυβερνητικοί παράγοντες."
		"Από την κατακόρυφη πτώση του Χρηματιστηρίου έμειναν άναυδοι όλοι σχεδόν οι κυβερνητικοί παράγοντες."
		"Ήταν ένα σουτ-κεραυνός του Κώστα Κιάσσο, που άφησε άναυδο το Σλοβάκο τερματοφύλακα Μπούτσεκ."
		"Έγινε συνείδηση της διεθνούς κοινότητας, που ανακαλύπτει έξαφνα, άναυδη κι αμήχανη, τα ίχνη μιας γενοκτονίας που ποτέ δεν σταμάτησε."))

