	(has_string "ανδρείκελο_1")
	(%3C%3Chas_ID%3E%3E [a-%CE%B1%CE%BD%CE%B4%CF%81%CE%B5%CE%AF%CE%BA%CE%B5%CE%BB%CE%BF_1])
	(has_case [Nominative])
	(has_gender [Neuter])
