	(UsageExample "Περιλαμβάνουν αυξημένη ούρηση, αίσθημα δίψας, απώλεια της όρεξης, ναυτία ή εμετό, υπνηλία ή κούραση, ερυθηματώδη ξηροδερμία, ξηροστομία και αναπνοή με φρουτώδη οσμή."))

([f-%CF%86%CF%81%CE%BF%CF%8D%CE%B4%CE%BF%CF%82] of  EL+GRAPHEME+CONTINUOUS ADJECTIVE+SINGLE

	(has_string "φρούδος")
	(%3C%3Chas_ID%3E%3E [f-%CF%86%CF%81%CE%BF%CF%8D%CE%B4%CE%BF%CF%82])
	(CanonicalForm [%CF%86%CF%81%CE%BF%CF%8D%CE%B4%CE%BF%CF%82])
	(has_degree [Base])
	(has_gender [Masculine])
	(has_gloss "που είναι μάταιος ή ανώφελος")
	(has_number [Singular])
	(has_synonym [m-%CE%BC%CE%AC%CF%84%CE%B1%CE%B9%CE%BF%CF%82])
	(instantiates [Concept-%CE%BC%CE%AC%CF%84%CE%B1%CE%B9%CE%BF%CF%82])
	(UsageExample
		"Εξάλλου το «μεξικανικό θαύμα» είχε προ πολλού γίνει καπνός και δεν μπορούσε να «πουλήσει» ούτε καν φρούδες ελπίδες."
		"Οι ατομικές λύσεις αποδείχτηκαν φρούδες."
		"Προς το παρόν ο λογαριασμός γράφει μηδέν, αλλά μας μένει η φρούδα παρηγοριά πως σταμάτησε ο κατήφορος και τουλάχιστον δεν παίρνονται νέα, χειρότερα μέτρα."
		"Ανέκαθεν η πρακτική των πολιτικάντηδων υποτιμούσε τη νοημοσύνη του κόσμου με ψεύδη, φρούδες υποσχέσεις -ή παραλείψεις- ενίοτε με χοντροκομμένες εκφράσεις αλλά και αμίμητα φραστικά ατοπήματα."))

