([a-%CE%B1%CF%80%CE%B7%CE%BD%CE%AE%CF%82] of  EL+GRAPHEME+CONTINUOUS ADJECTIVE+SINGLE

	(has_string "απηνής")
	(%3C%3Chas_ID%3E%3E [a-%CE%B1%CF%80%CE%B7%CE%BD%CE%AE%CF%82])
	(has_degree [Base])
	(has_gender [Masculine])
	(has_gloss "που χαρακτηρίζεται από αγριότητα")
	(has_number [Singular])
	(has_specific_use [RegisterFormal])
	(instantiates [Concept-%CF%83%CE%BA%CE%BB%CE%B7%CF%81%CF%8C%CF%82])
	(UsageExample
		"Χαρακτηρίζοντας «προσπάθεια» τον απηνή βομβαρδισμό της Γιουγκοσλαβίας επί 76 νύχτες και μιλώντας με τον αέρα του θριαμβευτή, ο Αμερικανός υπουργός τόνισε:"
		"	Μέσα από έναν σκληρό, απηνή ρεαλισμό, όλοι οι ήρωες –πλην του υψηλόφρονος Πυλάδη– προσπαθούν να σώσουν το τομάρι τους."
		"Το μέχρι στιγμής νόμιμο κουρδικό κόμμα HADEP, που παρά τους απηνείς διωγμούς, που υφίσταται, θριάμβευσε στις επαρχίες του τουρκικού Κουρδιστάν, στις δημοτικές εκλογές."))

