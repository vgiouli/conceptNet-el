		[p-%CF%80%CE%BB%CE%B7%CE%B3%CF%8E%CE%BD%CF%89_1]
		[p-%CF%80%CE%BB%CE%B7%CE%B3%CF%8E%CE%BD%CF%89_2])
	(UsageExample
		"Συμβουλευθείτε γιατρό, εάν παρατηρήσετε κάποιο εξόγκωμα, πληγή που δε θεραπεύεται (και μέσα στο στόμα), κρεατοελιά που αλλάζει σχήμα, μέγεθος ή χρώμα, ή μη φυσιολογικές αιμορραγίες."
		"Γύρω από την πληγή υπάρχει έγκαυμα και υπολείμματα πυρίτιδας."
		"Μετά από μερικές δύσκολες εβδομάδες, η πληγή τελικά επουλώθηκε."
		"Η πληγή άνοιξε και το αίμα πότισε τους επιδέσμους."))

([p-%CF%80%CE%BB%CE%B7%CE%B3%CE%AE_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "πληγή_2")
