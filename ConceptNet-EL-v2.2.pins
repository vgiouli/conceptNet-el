([m-%CE%BC%CF%8D%CE%B4%CF%81%CE%BF%CF%82] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "μύδρος")
	(%3C%3Chas_ID%3E%3E [m-%CE%BC%CF%8D%CE%B4%CF%81%CE%BF%CF%82])
	(CanonicalForm [%CE%BC%CF%8D%CE%B4%CF%81%CE%BF%CF%82])
	(has_case [Nominative])
	(has_gender [Masculine])
	(has_gloss "κατηγορία")
	(has_number [Singular])
	(instantiates [Concept-%CE%BC%CE%BF%CE%BC%CF%86%CE%AE])
	(UsageExample
		"Στην ανακοίνωση του, το κόμμα εξαπολύει μύδρους κατά της κυβέρνησης Τραμπ"
		"Με βάση τα αυστηρά κριτήρια αξιολόγησης, \"κόπηκε\" μια από τις μεγαλύτερες οργανώσεις, ο πρόεδρος της οποίας για πολύ καιρό εξαπέλυε μύδρους εναντίον του WWF Ελλάς."
		"Ο δημοσιογράφος ετοιμαζόταν να εκτοξεύσει μύδρους κατά παντός όταν μπήκε στην αίθουσα ο υπουργός"
		"Η Νέα Δημοκρατία δέχεται μύδρους και από Βουλευτές του κυβερνώντος κόμματος και από μερικούς Υπουργούς ότι δεν σέβεται το Σύνταγμα, διότι τάχα το Σύνταγμα καθιέρωσε το απόλυτο ασυμβίβαστο."
		"Το Ιράν εξαπέλυσε μύδρους εναντίον της Ουάσιγκτον."
		"Ο τέταρτος της παρέας, ο Ολυμπιακός, αναλώθηκε χθες σε μύδρους κατά των διαιτητών"
		"Η αντιπολίτευση εξαπέλυσε μύδρους για την «αποτυχία» της κυβέρνησης."))

([m-%CE%BC%CF%8D%CE%B7%CF%83%CE%B7] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

