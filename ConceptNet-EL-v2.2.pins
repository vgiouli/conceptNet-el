	(has_string "περπατάω_1")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%AC%CF%89_1])
	(has_tense [PresentTense])
	(instantiates [Concept-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%AC%CF%89.01])
	(is_morphologically_related_to
		[p-%CF%80%CE%B5%CF%81%CF%80%CE%AC%CF%84%CE%B7%CE%BC%CE%B1]
		[p-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%AC%CF%89_2]
		[p-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%B7%CF%83%CE%B9%CE%AC]
		[p-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%B7%CF%84%CF%8C%CF%82]
		[p-%CF%80%CE%B5%CF%81%CF%80%CE%B1%CF%84%CE%BF%CF%8D%CF%81%CE%B1])
	(UsageExample
		"οι διαβάτες περπατούν βιαστικά, να προλάβουν να φτάσουν σπίτι προτού ξεσπάσει η μπόρα"
		"περπατώ μερικές φορές στους δρόμους της Αθήνας και μου κόβονται τα πόδια."
		"Σε αυτήν την πόλη με τους χωματόδρομους εξακολουθεί να περπατά ξυπόλητος ο Λουίς με τη φαντασία του στα ταξίδια της μνήμης"
		"περπάτησε τη Μικρασία φαντάρος από 17 χρονών"
		"Του έκανα την πρόταση να ταξιδέψουμε μαζί στη Σινασό, να περπατήσουμε τα στενά της, να ψάξουμε για το παλιό σπίτι της οικογένειας"
		"Περπατά ως τη Λάρκο και παίρνει το λεωφορείο"
		"Βγήκες μαζί τους από τη συγκέντρωση και δεν έβαλες γλώσσα μέσα σου καθώς περπατούσατε προς το κέντρο"
		"Στο κέντρο πήραν ένα λεωφορείο για τον Ρίμακ και μετά περπάτησαν καναδυό τετράγωνα."))

