		[a-%CE%B1%CE%B4%CE%B9%CE%AD%CE%BE%CE%BF%CE%B4%CE%BF%CF%82])
	(UsageExample
		"Πώς από τη Μακρινίτσης στρίβουν στην Αχιλοπούλου και αμέσως μετά, μέσα απ' το στενό αδιέξοδο, φτάνουν στο σπίτι."
		"Πρέπει να γυρίσουμε πίσω, δεν βλέπεις ότι βρεθήκαμε σε αδιέξοδο;"
		"επισπεύδονται οι διαδικασίες απαλλοτρίωσης τεσσάρων ακινήτων στο αδιέξοδο της οδού Χατζηχρήστου και στο ακίνητο της οδού Μητσαίων"))

([a-%CE%B1%CE%B4%CE%B9%CE%AD%CE%BE%CE%BF%CE%B4%CE%BF_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "αδιέξοδο_2")
	(%3C%3Chas_ID%3E%3E [a-%CE%B1%CE%B4%CE%B9%CE%AD%CE%BE%CE%BF%CE%B4%CE%BF_2])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "πολύ δύσκολη κατάσταση από την οποία δεν υπάρχει τρόπος διαφυγής")
	(has_number [Singular])
	(is_morphologically_related_to
		[a-%CE%B1%CE%B4%CE%B9%CE%AD%CE%BE%CE%BF%CE%B4%CE%BF_1]
		[a-%CE%B1%CE%B4%CE%B9%CE%AD%CE%BE%CE%BF%CE%B4%CE%BF%CF%82])
	(UsageExample
		"από το 1993 έως το 2003, δεκάδες γαλλικές επιχειρήσεις του κλάδου οδηγήθηκαν σε αδιέξοδο, με αποτέλεσμα την απώλεια περισσοτέρων από το 30% των θέσεων εργασίας στη γαλλική βιομηχανία της μόδας"
		"ς ελπίσουμε ότι ο πρωθυπουργός δεν θα συναινέσει και δεν θα δεχθεί απόψεις που οδηγούν την αγροτική οικονομία σε αδιέξοδο"
		"Με τα στοιχεία που έχουμε, γνωρίζουμε ότι σε 15 χρόνια από σήμερα, θα βρεθεί πάλι σε προβληματική κατάσταση για να μην πω σε αδιέξοδο."
		"Στελέχη τραπεζών υπογραμμίζουν ότι οι εισφορές που καταβάλλουν στο ΙKA εδώ και δεκαετίες οι βιομηχανίες και άλλες επιχειρήσεις είναι ιδιαίτερα χαμηλές, δεν αρκούν να καλύψουν τις ασφαλιστικές υποχρεώσεις προς τους εργαζόμενες και εν τέλει είναι οι κύριες υπεύθυνες για το σημερινό οικονομικό αδιέξοδο του ΙKA."))

