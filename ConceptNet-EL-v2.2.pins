	(has_degree [Base])
	(is_morphologically_related_to [a-%CE%B1%CE%BA%CF%81%CE%AC%CE%B4%CE%B1%CE%BD%CF%84%CE%BF%CF%82])
	(UsageExample
		"Ο γράφων, προερχόμενος από το αμερικανικό σύστημα εκπαίδευσης, πιστεύει ακράδαντα στον ανταγωνισμό σαν παράγοντα προόδου."
		"Πιστεύω ακράδαντα στην επικοινωνία με τον κόσμο και στη συμμετοχή του κόσμου"
		"ο τεχνικός της «μεγάλης κυρίας», πιστεύει ακράδαντα στις δυνατότητες της ομάδας του"
		"Η κυβέρνηση πιστεύει ακράδαντα ότι η εξωτερική πολιτική πρέπει να αποτελεί το σημείο σύμπτωσης των κομμάτων και όχι σημείο αντιδικίας τους."))

([a-%CE%B1%CE%BA%CF%81%CE%AC%CE%B4%CE%B1%CE%BD%CF%84%CE%BF%CF%82] of  EL+GRAPHEME+CONTINUOUS ADJECTIVE+SINGLE

	(has_string "ακράδαντος")
