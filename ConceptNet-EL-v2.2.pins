	(has_string "κρούσμα")
	(%3C%3Chas_ID%3E%3E [k-%CE%BA%CF%81%CE%BF%CF%8D%CF%83%CE%BC%CE%B1])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "περίπτωση ή περιστατικό εκδήλωσης φαινομένου, συνήθως αρνητικού")
	(has_number [Singular])
	(has_specific_use [RegisterNegative])
	(instantiates [Concept-%CE%BA%CF%81%CE%BF%CF%8D%CF%83%CE%BC%CE%B1])
	(is_morphologically_related_to [k-%CE%BA%CF%81%CE%BF%CF%8D%CF%89])
	(UsageExample
		" οι τράπεζες εξακολουθούν να εμφανίζουν λίαν καθησυχαστικά στοιχεία σε ό,τι αφορά τα μη εξυπηρετούμενα δάνεια, παρά την οικονομική στενότητα που παρατηρείται σε πολλούς τομείς οικονομικής δραστηριότητας και τα αυξημένα κρούσματα επιχειρήσεων που αδυνατούν να ανταποκριθούν στις τραπεζικές τους υποχρεώσεις."
		"Τα πρόσφατα κρούσματα παραβατικών πράξεων ανηλίκων σε διάφορες περιοχές του Πειραιά, με πέντε τραυματίες εκ των οποίων οι δύο σοβαρά, είχαν σαν αποτέλεσμα να ενεργοποιηθεί από την Εισαγγελία της πόλης το άρθρο 360 του Ποινικού Κώδικα"
		"Τα κρούσματα δικτυοπειρατείας και τηλεπικοινωνιακής απάτης αυξάνονται με ιλιγγιώδεις ρυθμούς"
		"Ενδεικτικά, το 1997 στη συγκεκριμένη Μονάδα καταγράφηκαν 12 περιστατικά αμιαντώσεων, το 2003 τα κρούσματα διπλασιάστηκαν φθάνοντας τα 31 και μέχρι το Σεπτέμβριο του 2004 τα 26."))

