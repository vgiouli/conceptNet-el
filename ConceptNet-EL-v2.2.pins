		[t-%CF%84%CE%BF%CE%BE%CF%8C%CF%84%CE%B7%CF%82]
		[t-%CF%84%CE%BF%CE%BE%CF%8C%CF%84%CF%81%CE%B9%CE%B1])
	(UsageExample
		"Εκεί είχε βγει για κυνήγι τίγρης, μαζί με τους αυλικούς του, ο μαχαραγιάς της περιοχής, ο οποίος, βλέποντας κάτι να σαλεύει ανάμεσα στα φυλλώματα, σημαδεύει με το τόξο του."
		"Αφήνει το τόξο και τη φαρέτρα, φορτώνεται στους ώμους του τον ζυγό με τα καλάθια και συνεχίζει το μακρύ οδοιπορικό του"))

([t-%CF%84%CF%8C%CE%BE%CE%BF_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "τόξο_2")
	(%3C%3Chas_ID%3E%3E [t-%CF%84%CF%8C%CE%BE%CE%BF_2])
	(CanonicalForm [%CF%84%CF%8C%CE%BE%CE%BF])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_number [Singular])
	(is_morphologically_related_to
		[t-%CF%84%CE%BF%CE%BE%CF%8C%CF%84%CE%B7%CF%82]
		[t-%CF%84%CF%8C%CE%BE%CE%BF_1]
		[t-%CF%84%CE%BF%CE%BE%CF%8C%CF%84%CF%81%CE%B9%CE%B1])
	(UsageExample
		"Το ηφαίστειο της Σαντορίνης βρίσκεται πάνω στο ηφαιστειακό τόξο του νοτίου Αιγαίου και οι περίοδοι ενεργοποίησής του κυμαίνονταν από 9 χρόνια έως 8 αιώνες."
		"Στη «μαύρη λίστα» των επικίνδυνων περιοχών, στην κατηγορία ΙV του αντισεισμικού κανονισμού, βρίσκονται μόνο πέντε περιοχές, όλες στο τόξο του Ιονίου Πελάγους, το οποίο δίνει και τους μεγαλύτερους σεισμούς στη χώρα μας."
		"Θ' άντεχαν τα ελληνικά μνημεία σε ένα χτύπημα του Εγκέλαδου ανάλογο με αυτό που καταγράφηκε στο τόξο της Ανατολίας;"))

