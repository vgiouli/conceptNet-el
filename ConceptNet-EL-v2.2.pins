	(is_morphologically_related_to
		[d-%CE%B4%CE%B9%CE%B1%CF%86%CE%AC%CE%BD%CE%B5%CE%B9%CE%B1_1]
		[d-%CE%B4%CE%B9%CE%B1%CF%86%CE%AC%CE%BD%CE%B5%CE%B9%CE%B1_2]
		[d-%CE%B4%CE%B9%CE%B1%CF%86%CE%AC%CE%BD%CE%B5%CE%B9%CE%B1_3]
		[d-%CE%B4%CE%B9%CE%B1%CF%86%CE%B1%CE%BD%CE%AE%CF%82_2]
