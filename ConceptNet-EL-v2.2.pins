		[d-%CE%B4%CE%B1%CF%83%CE%BA%CE%AC%CE%BB%CE%B1]
		[d-%CE%B4%CE%B9%CE%B4%CE%B1%CF%83%CE%BA%CE%B1%CE%BB%CE%AF%CE%B1_2]
		[d-%CE%B4%CE%B9%CE%B4%CE%B1%CF%83%CE%BA%CE%B1%CE%BB%CE%B5%CE%AF%CE%BF]
