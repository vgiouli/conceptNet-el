	(has_gender [Feminine])
	(has_gloss "η διαδιικασία παραγωγής κρασιού")
	(has_number [Singular])
	(UsageExample
		"Η ονομασία επιζεί μέχρι σήμερα στις ετικέτες των σαντορινιών κρασιών χωρίς, ωστόσο, να επιζεί και η παραδοσιακή μέθοδος οινοποίησης"
		"Η έναρξη της ερυθρής οινοποίησης πραγματοποιείται με την έκθλιψη και αποβοστρύχωση των σταφυλιών από ειδικά μηχανήματα."
		"οι πρωτεΐνες παίζουν ένα σημαντικό οικονομικό και τεχνολογικό ρόλο στην οινοποίηση επηρεάζοντας την σταθερότητα και την καθαρότητα των οίνων."))

