	(has_degree [Base])
	(has_gloss "σε τακτά χρονικά διαστήματα")
	(instantiates [Concept-%CF%80%CE%B5%CF%81%CE%B9%CE%BF%CE%B4%CE%B9%CE%BA%CE%AC])
	(is_morphologically_related_to
		[p-%CF%80%CE%B5%CF%81%CE%B9%CE%BF%CE%B4%CE%B9%CE%BA%CF%8C%CF%82]
