([p-%CF%80%CF%81%CE%AC%CE%BE%CE%B7_1] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "πράξη_1")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CF%81%CE%AC%CE%BE%CE%B7_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "η ενέργεια του πράττω")
	(has_number [Singular])
	(is_morphologically_related_to
		[a-%CE%AC%CF%80%CF%81%CE%B1%CE%BA%CF%84%CE%BF%CF%82]
		[p-%CF%80%CF%81%CE%AC%CE%BE%CE%B7_2]
		[p-%CF%80%CF%81%CE%AC%CF%84%CF%84%CF%89]
		[a-%CE%B1%CF%80%CF%81%CE%B1%CE%BE%CE%AF%CE%B1])
	(UsageExample
		"Η πρωτοβουλία αυτή του πρωθυπουργού πιθανώς έχει επιπτώσεις -όχι μόνο σε επικοινωνιακό επίπεδο- στην εσωτερική πολιτική σκηνή, καθώς είναι μια κίνηση, που δίνει το δικαίωμα στην παράταξή του να ισχυρίζεται ότι έκανε πράξη τον πολιτικό της λόγο για το «τέλος των διαχωριστικών γραμμών"
		"Θα αξίωνε, όμως, διερεύνηση των φημών και έλεγχο της συμπεριφοράς τού συγκεκριμένου λειτουργού, προτού η κακή φήμη «αναβαθμιστεί» σε αποκαλύψεις και καταγγελίες για αξιόποινες πράξεις"
		"Για τις περιπτώσεις αυτές έχουν γραφεί αναρίθμητα άρθρα, καμιά όμως από τις πράξεις αυτές δεν έχει ιδωθεί μέσα από το πρίσμα μιας σπονδυλωτής αλλά αδιαίρετης πράξης"
		"Κατά συνέπεια, σύμφωνα με την ερμηνεία που δίνει η ΔΕΗ στο παραπάνω άρθρο, η εταιρεία αποζημιώνει τον καταναλωτή μόνο στις περιπτώσεις όπου υπάρχει ευθύνη των υπαλλήλων της ΔΕΗ από πράξεις ή παραλείψεις τους."))

