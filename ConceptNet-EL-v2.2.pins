	(%3C%3Chas_ID%3E%3E [mwe-%CE%B4%CE%AF%CE%B3%CF%81%CE%B1%CE%BC%CE%BC%CE%B7_%CE%B5%CF%80%CE%B9%CF%84%CE%B1%CE%B3%CE%AE])
