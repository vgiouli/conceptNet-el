([n-%CE%BD%CE%BF%CE%BF%CF%84%CF%81%CE%BF%CF%80%CE%AF%CE%B1] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "νοοτροπία")
	(%3C%3Chas_ID%3E%3E [n-%CE%BD%CE%BF%CE%BF%CF%84%CF%81%CE%BF%CF%80%CE%AF%CE%B1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "τρόπος σκέψης που καθορίζει τη στάση και συμπεριφορά μας")
	(has_number [Singular])
	(UsageExample
		"Καλά τα μέτρα και οι εξαγγελίες για κάθαρση - αλλά για να αλλάξουμε τη συλλογική εθνική νοοτροπία μας, θέλει δουλειά (παιδεία, πάνω απ' όλα!) εξ απαλών ονύχων..."
		"Για τις συγκρούσεις αυτές -οι οποίες μπορεί και πρέπει να αποφεύγονται, γιατί οι πραγματικοί ανταγωνιστές της εταιρείας που είναι οι εξωτερικοί κερδίζουν έδαφος αμαχητί- συμβαίνει συχνά να ευθύνεται και η νοοτροπία ορισμένων μάνατζερ που λειτουργούν σύμφωνα με την αρχή του «διαίρει και βασίλευε»."
		"Διότι αυτή η άποψη είναι χαρακτηριστική μιας νοοτροπίας που κρατάει ακόμη καθηλωμένη τη χώρα."
		"Μιλάει για τη νοοτροπία ορισμένων ερευνητών να θεωρούν εαυτούς υπεράνω αξιολόγησης του έργου τους και υπόσχεται ότι θα συμβάλλει τα μέγιστα αυτές οι συμπεριφορές να εκλείψουν."))

