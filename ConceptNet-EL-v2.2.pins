([p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_1] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "πλατεία_1")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "μεγάλης έκτασης επίπεδος, ακάλυπτος και διαμορφωμένος χώρος μέσα σε κατοικημένη περιοχή (πόλης ή χωριού)")
	(has_number [Singular])
	(instantiates [Concept-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1])
	(is_morphologically_related_to
		[p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_2]
		[p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%B9%CE%AC%CE%B6%CF%89])
	(UsageExample
		"Ιδιαίτερα τις ημέρες των Χριστουγέννων, μπορεί κανείς να επισκεφθεί την πλατεία της παλιάς πόλης όπου στήνεται η χριστουγεννιάτικη αγορά με χειροποίητα ξύλινα παιχνίδια και κρυστάλλινα διακοσμητικά."
		"Συμβολική αφετηρία ήταν η συγκέντρωση, την Τετάρτη, όλων των μεγάλων και ισχυρών των ευρωπαϊκών Βρυξελλών στην πλατεία Σουμάν, τον συμβολικό ομφαλό της Ένωσης στις Βρυξέλλες, όπου και τηρήθηκαν τρία λεπτά σιγής εις μνήμην των θυμάτων."))

([p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "πλατεία_2")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_2])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "τμήμα του σύγχρονου θεάτρου ή του κινηματογράφου στο οποίο βρίσκονται τα καθίσματα όπου κάθονται οι θεατές")
	(has_number [Singular])
	(instantiates [Concept-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1-%CE%B8%CE%AD%CE%B1%CF%84%CF%81%CE%BF])
	(is_morphologically_related_to
		[p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%AF%CE%B1_1]
		[p-%CF%80%CE%BB%CE%B1%CF%84%CE%B5%CE%B9%CE%AC%CE%B6%CF%89])
	(UsageExample
		"Περίμενε, κρατούσε τους μουσικούς σε ετοιμότητα κι όταν γινόταν απόλυτη σιγή, τότε άρχιζε να διευθύνει, και έπαιρνε μαζί την κατάμεστη Αίθουσα των Φίλων της Μουσικής, πλατεία και θεωρεία."
		"Ευχαριστώ τον Θεό (και το Μέγαρο) για το εισιτήριο της πλατείας, εβδόμη σειρά, διάδρομος, που μού έδωσε, ώστε να μπορέσω να βλέπω, σαν μαγνητισμένη, αυτόν τον απόλυτο γνώστη της παρτιτούρας να διευθύνει απέξω, να μοιράζει απλόχερα στους μουσικούς –που και αυτοί είχαν καρφωμένο το βλέμμα τους επάνω του, και όχι στο αναλόγιο με τις πάρτες– τη γνώση και την αγάπη του για κάθε μέρος της συμφωνίας, πασίγνωστης, που, όμως, το βράδυ της Πέμπτης, ήταν σαν να την ακούγαμε για πρώτη φορά!"))

