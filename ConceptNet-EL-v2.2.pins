([k-%CE%BA%CE%B5%CF%81%CE%AF_1] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "κερί_1")
	(%3C%3Chas_ID%3E%3E [k-%CE%BA%CE%B5%CF%81%CE%AF_1])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "χημική ένωση")
	(has_number [Singular])
	(is_morphologically_related_to
		[k-%CE%BA%CE%AD%CF%81%CE%B9%CE%BD%CE%BF%CF%82]
		[k-%CE%BA%CE%B5%CF%81%CE%AF_2]
		[k-%CE%BA%CE%B5%CF%81%CE%AF_3]
		[k-%CE%BA%CE%B7%CF%81%CE%BF%CF%80%CE%AE%CE%B3%CE%B9%CE%BF]
		[k-%CE%BA%CE%B5%CF%81%CE%AD%CE%BD%CE%B9%CE%BF%CF%82]
		[k-%CE%BA%CE%B5%CF%81%CE%AE%CE%B8%CF%81%CE%B1])
	(UsageExample
		"Μετά την εξαγωγή του μελιού και του κεριού ό,τι απέμενε το χρησιμοποιούσαν για να φτιάξουν το περίφημο μελόρακο."
		"Υλικά όπως ο γύψος, το κερί το σίδηρο, το βελούδο ή το αστραχάν, τα μαλλιά εγκλείουν σημασίες και μνήμες, συνδεδεμένες με την ερημία, το μαρτύριο, τη θρησκεία, για τα οποία δεν φοβούνται να μιλούν αρκετοί από τους Βορειοευρωπαίους καλλιτέχνες."
		"απεικονίζει μία πινακίδα επιχρισμένη με κερί («tabula cerata») "))

([k-%CE%BA%CE%B5%CF%81%CE%AF_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "κερί_2")
	(%3C%3Chas_ID%3E%3E [k-%CE%BA%CE%B5%CF%81%CE%AF_2])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "κατασκεύασμα από κερί το οποίο έχει φυτίλι στο κέντρο")
	(has_number [Singular])
	(is_morphologically_related_to
		[k-%CE%BA%CE%B5%CF%81%CE%AF_1]
		[k-%CE%BA%CE%AD%CF%81%CE%B9%CE%BD%CE%BF%CF%82]
		[k-%CE%BA%CE%B5%CF%81%CE%AF_3]
		[k-%CE%BA%CE%B7%CF%81%CE%BF%CF%80%CE%AE%CE%B3%CE%B9%CE%BF]
		[k-%CE%BA%CE%B5%CF%81%CE%AD%CE%BD%CE%B9%CE%BF%CF%82]
		[k-%CE%BA%CE%B5%CF%81%CE%AE%CE%B8%CF%81%CE%B1])
	(UsageExample
		"Τα κεριά που ανάβουν ευλαβικά οι πιστοί στο εσωτερικό των ναών βλάπτουν σοβαρά τη βυζαντινή τέχνη."
		"Ύστερα έσβηνε τα κεριά ή τις λάμπες -- σκοτάδι απόλυτο."
		"Το γρασίδι μπροστά στο κτίριο γέμισε με κεριά και λουλούδια."
		"Να ανάψει ένα κερί στον τάφο του πατέρα του ήταν η πρώτη επιθυμία του Έλληνα ναυτικού"
		"Με την έλευση όμως του ηλεκτρισμού, τη θέση των κεριών πήραν τα πάσης φύσεως λαμπιόνια."
		"Βραβεία - στολίδια, «ζαχαρωτά» στην τούρτα με τα 29 κεριά που σβήνει, γεννημένος στις 4 Ιανουαρίου 1969, σήμερα."))

