	(UsageExample "Το χωριό αποτελεί την πιο χαρακτηριστική έκφραση της μυκονιάτικης επινοητικότητας που αντιστρατεύεται στους φτωχούς πόρους του νησιού τον λιτό και πρακτικό τρόπο ζωής."))

([l-%CE%BB%CE%B9%CF%84%CF%8C%CF%82_2] of  EL+GRAPHEME+CONTINUOUS ADJECTIVE+SINGLE

	(has_string "λιτός_2")
	(%3C%3Chas_ID%3E%3E [l-%CE%BB%CE%B9%CF%84%CF%8C%CF%82_2])
	(has_degree [Base])
	(has_gender [Masculine])
	(has_gloss "που είναι απλός, χωρίς περιττά στοιχεία")
	(has_number [Singular])
	(is_morphologically_related_to
		[l-%CE%BB%CE%B9%CF%84%CE%AC_1]
		[l-%CE%BB%CE%B9%CF%84%CF%8C%CF%84%CE%B7%CF%84%CE%B1]
		[l-%CE%BB%CE%B9%CF%84%CE%AC_2])
	(UsageExample
		"Οι ερμηνείες, το λιτό σκηνικό και η φωτογραφία του Ερίκ Γκοτιέ αποδείχτηκαν ο καλύτερος σύμμαχος του."
		"Η γραφή του, αφαιρετική και λιτή υπονομεύει τη ρεαλιστικότητα του συρμού υπέρ της ατμόσφαιρας και της ποιητικής θέασης των πραγμάτων, άμεσα συνδεδεμένης με τη μουσική που κυριαρχεί σε όλα τα βιβλία του."
		"«Επιθυμούμε να αποσαφηνίσουμε ότι ο Τζίμι δεν ήταν ένας μηδενιστής, αλλά ένας απλός άνθρωπος που όπως όλοι είχε τις σκοτεινές στιγμές του», αναφέρεται στη λιτή ανακοίνωση που εξέδωσαν οι Hope Of The States λίγες ημέρες μετά το τραγικό συμβάν."))

