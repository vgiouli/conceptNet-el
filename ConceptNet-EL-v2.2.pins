([z-%CE%B6%CE%BF%CF%86%CE%B5%CF%81%CE%AC] of  EL+GRAPHEME+CONTINUOUS ADVERB+SINGLE

	(has_string "ζοφερά")
	(%3C%3Chas_ID%3E%3E [z-%CE%B6%CE%BF%CF%86%CE%B5%CF%81%CE%AC])
	(has_degree [Base])
	(has_gloss "με τρόπο που εκφράζει απαισιοδοξία")
	(is_morphologically_related_to
		[z-%CE%B6%CE%BF%CF%86%CE%B5%CF%81%CF%8C%CF%82]
		[z-%CE%B6%CE%BF%CF%86%CE%B5%CF%81%CF%8C%CF%84%CE%B7%CF%84%CE%B1])
	(UsageExample
		"Οι εμπνεύσεις του δεν προέρχονται μόνο από «ζωντανά» μοντέλα, αλλά πολύ συχνά από εικόνες -πίνακες παλιών φημισμένων ζωγράφων, φωτογραφίες από εφημερίδες, πλάνα από ταινίες, ακόμα και ακτινογραφίες - τις οποίες αποδίδει ζοφερά παραμορφωμένες, εκφράζοντας ένα βαθύ αίσθημα μοναξιάς και απόγνωσης, φθοράς και αποσύνθεσης."
		"Η τραγική επικαιρότητα της 7ης Ιουλίου, ακριβώς μια μέρα μετά την ανάληψη των Ολυμπιακών Αγώνων του 2012, συνδέθηκε άμεσα με την τετραπλή και συντονισμένη επίθεση στον υπόγειο του Λονδίνου, επαναφέροντας τις ζοφερές εικόνες από τον Δεύτερο Παγκόσμιο Πόλεμο και τη «Μάχη της Αγγλίας»."))

([z-%CE%B6%CE%BF%CF%86%CE%B5%CF%81%CF%8C%CF%82] of  EL+GRAPHEME+CONTINUOUS ADJECTIVE+SINGLE

	(has_string "ζοφερός")
