	(has_degree [Base])
	(has_gender [Masculine])
	(has_gloss "που είναι σύμφωνος με τη λογική_1")
	(has_number [Singular])
	(has_synonym [e-%CE%B5%CF%8D%CE%BB%CE%BF%CE%B3%CE%BF%CF%82])
	(is_morphologically_related_to
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CF%8C]
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%B5%CF%8D%CF%89]
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%AE_1]
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%AE_2]
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%AC]
		[l-%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CF%8C%CF%82_2]
		[e-%CE%B5%CE%BA%CE%BB%CE%BF%CE%B3%CE%B9%CE%BA%CE%B5%CF%8D%CF%89])
	(UsageExample
		"Το χειρότερο είναι ότι η ίδια η Ε.Ε. μοιάζει να αποδέχεται ως λογική τη στάση αυτή της Τουρκίας, θεωρώντας προφανώς ότι με ευθύνη της Λευκωσίας δεν έχει υπάρξει λύση και συνεπώς υπάρχει ένα αδιέξοδο που πρώτα πρέπει να αρθεί και μετά να γίνουν οι απαραίτητες και αυτονόητες τουρκικές ενέργειες."
		"δύσκολα θα βρεθεί λογικός και εχέφρων άνθρωπος σε τούτη τη χώρα που θα αρνηθεί ότι πέρα και άσχετα από μικροπολιτικές τοποθετήσεις και κινήσεις σκοπιμότητας και πρόσκαιρου εντυπωσιασμού, τα σωρευμένα προβλήματα που αντιμετωπίζει ο τόπος, και δη σε καίριους και αποφασιστικούς τομείς, απαιτούν άμεσες και γενναίες παρεμβάσεις"
		"Έχει λογική εξήγηση (εκτός από την προφανή: πως δεν εκμεταλλευόμαστε σωστά και προγραμματισμένα τα συγκριτικά πλεονεκτήματα της πόλης!"
		"Ο αρμόδιος διπλωματικός υπάλληλος είναι λογικό να επιδεικνύει ζήλο στην προσπάθειά του να φέρει εις πέρας αποστολή ηθικής αξιολογήσεως του σύμπαντος κόσμου"))

