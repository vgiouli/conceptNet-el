([mwe-%CE%AC%CE%B3%CE%BF%CE%BC%CE%B1%CE%B9_%CE%BA%CE%B1%CE%B9_%CF%86%CE%AD%CF%81%CE%BF%CE%BC%CE%B1%CE%B9] of  EL-MWE VERB+MW 2_ARGUMENTS

	(has_string "άγομαι και φέρομαι")
	(%3C%3Chas_ID%3E%3E [mwe-%CE%AC%CE%B3%CE%BF%CE%BC%CE%B1%CE%B9_%CE%BA%CE%B1%CE%B9_%CF%86%CE%AD%CF%81%CE%BF%CE%BC%CE%B1%CE%B9])
	(fixed+elements root)
	(has_elements
		"άγω"
		"και"
		"φέρω")
	(has_gloss "παρασύρομαι και κάνω ό,τι μου πουν οι άλλοι, δεν έχω ισχυρή θέληση")
	(has_literal_meaning FALSE)
	(has_tense [PresentTense])
	(instantiates [Concept-%CE%AC%CE%B3%CE%BF%CE%BC%CE%B1%CE%B9_%CE%BA%CE%B1%CE%B9_%CF%86%CE%AD%CF%81%CE%BF%CE%BC%CE%B1%CE%B9])
	(mwe_type MVC)
	(UsageExample
		"Αυτά τα κωμικοτραγικά συμβαίνουν όταν υπάρχουν λαοί που άγονται και φέρονται από πολιτικούς και μέσα ενημέρωσης που δεν ξέρουν πού τους πάν' τα τέσσερα."
		"Όλα αυτά είναι δείγματα μια εποχής στην οποία κυριαρχεί η σύγχυση και η κοινή γνώμη άγεται και φέρεται από τυχαία γεγονότα κι εντυπώσεις της στιγμής."
		"οι διατάξεις του νόμου για τον ΟΤΕ ποιες ουσιαστικές ασφαλιστικές δικλίδες βάζουν, ώστε το κράτος - μέτοχος να λειτουργεί υπέρ των συνδρομητών και να μην άγεται και φέρεται από τον \"στρατηγικό επενδυτή\";")
	(V_declension V)
	(arg0_has_grammatical_function nsubj)
	(arg0_has_the_semantic_role Patient)
	(arg0_Type np_nm)
	(arg1_has_grammatical_function ccomp)
	(arg1_has_the_semantic_role Agent)
	(arg1_Type pp))

([mwe-%CE%AC%CE%B3%CE%BF%CE%BD%CE%B7_%CE%B3%CF%81%CE%B1%CE%BC%CE%BC%CE%AE] of  EL-MWE NOUN+MW

	(has_string "άγονη γραμμή")
	(%3C%3Chas_ID%3E%3E [mwe-%CE%AC%CE%B3%CE%BF%CE%BD%CE%B7_%CE%B3%CF%81%CE%B1%CE%BC%CE%BC%CE%AE])
	(Declension-Pattern adj_N)
	(has_case [Nominative])
	(has_elements
		"άγονος"
		"γραμμή")
	(has_gender [Feminine])
	(has_gloss "γραμμή πλοίου που δεν παρουσιάζει εμπορική ή επιβατική κίνηση")
	(has_number [Singular])
	(mwe_type NID)
	(only+singular TRUE)
	(UsageExample
		"Από την πλευρά του το υπουργείο Εμπορικής Ναυτιλίας εκπονεί σχέδιο που προβλέπει τη δαπάνη 300 εκατ. ευρώ για την επιδότηση των άγονων γραμμών."
		"Οι νέες μονάδες ΑΤΜ θα εγκαθίστανται κυρίως εκτός τραπεζικών καταστημάτων και θα βρίσκονται πλέον σχεδόν παντού: σε αεροδρόμια, λιμάνια, σταθμούς, εμπορικούς δρόμους, επιχειρήσεις, πολυκαταστήματα, πρατήρια καυσίμων, μέχρι πλοία, νησιά άγονης γραμμής που δεν υπάρχει τραπεζικό κατάστημα κ.λπ."))

([mwe-%CE%AC%CE%B3%CF%81%CE%B1%CF%86%CE%BF%CF%82_%CE%BD%CF%8C%CE%BC%CE%BF%CF%82] of  EL-MWE NOUN+MW

	(has_string "άγραφος νόμος")
	(%3C%3Chas_ID%3E%3E [mwe-%CE%AC%CE%B3%CF%81%CE%B1%CF%86%CE%BF%CF%82_%CE%BD%CF%8C%CE%BC%CE%BF%CF%82])
	(Declension-Pattern adj_N)
	(has_case [Nominative])
	(has_elements
		"άγραφος"
		"νόμος")
	(has_gender [Masculine])
	(has_gloss "σύνολο κανόνων δικαίου που δεν υπάρχουν κάπου γραμμένοι")
	(has_number [Singular])
	(instantiates [Concept-%CE%BD%CF%8C%CE%BC%CE%BF%CF%82_%CE%AC%CE%B3%CF%81%CE%B1%CF%86%CE%BF%CF%82])
	(mwe_type NID)
	(UsageExample
		"Ανοικτή πρόκληση με πολλούς αποδέκτες να τηρηθεί η νομιμότητα, όπως και οι «άγραφοι αλλά παραδοσιακοί νόμοι της υπευθυνότητας» απευθύνει ο κ. Δημήτρης Δασκαλόπουλος πρόεδρος του Συνδέσμου Ελληνικών Βιομηχανιών Τροφίμων (ΣΕBT)"
		"Υπάρχει ένας άγραφος νόμος στο ποδόσφαιρο, που λέει ότι αν δεν πετύχεις γκολ, θα το φας."
		"Μόλις έγινε γνωστός ο θάνατος των δύο κρατουμένων, που σύμφωνα με την Αστυνομία πολύ πιθανόν να προήλθε από την υπερβολική χρήση κάποιας ναρκωτικής ουσίας, την οποία τα θύματα είχαν αναμίξει με βαρβιτουρικά χάπια και αλκοόλ, έπεσε ο άγραφος νόμος της σιωπής."
		"Με μαρτυρίες τους Κορσικανοί ζητούν να «λυθεί ο άγραφος νόμος της σιωπής» που καλύπτει τους ενόχους και να λειτουργήσει το κράτος του νόμου»."))

