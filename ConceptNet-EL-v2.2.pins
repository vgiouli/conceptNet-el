([a-%CE%B1%CE%BA%CF%85%CF%81%CF%8E%CE%BD%CF%89_1] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "ακυρώνω_1")
	(%3C%3Chas_ID%3E%3E [a-%CE%B1%CE%BA%CF%85%CF%81%CF%8E%CE%BD%CF%89_1])
	(CanonicalForm [%CE%B1%CE%BA%CF%85%CF%81%CF%8E%CE%BD%CF%89])
	(has_gloss "καθιστώ άκυρο")
	(has_tense [PresentTense])
	(is_morphologically_related_to
		[a-%CE%B1%CE%BA%CF%85%CF%81%CF%8E%CE%BD%CF%89_2]
		[a-%CE%B1%CE%BA%CF%85%CF%81%CF%89%CF%84%CE%B9%CE%BA%CF%8C%CF%82]
		[a-%CE%B1%CE%BA%CF%8D%CF%81%CF%89%CF%83%CE%B7_1]
		[a-%CE%B1%CE%BA%CF%8D%CF%81%CF%89%CF%83%CE%B7_2]
		[a-%CE%AC%CE%BA%CF%85%CF%81%CE%BF%CF%82])
	(UsageExample
		"Στις 22 Μαρτίου 2001 εκδικάζεται η αίτηση του Συλλόγου και το ΣτΕ ακυρώνει τη συγκεκριμένη οικοδομική άδεια."
		"Ο πρώτος διαγωνισμός πραγματοποιήθηκε το 2001, αλλά ακυρώθηκε από τη σημερινή κυβέρνηση επειδή «σερνόταν» επί χρόνια εν μέσω δεκάδων προσφυγών από τους εργολήπτες"
		"Την περασμένη εβδομάδα, η κυβέρνηση της Κεντροαριστεράς ακύρωσε την ειλημμένη απόφασή της να προχωρήσει σε πρόωρες εκλογές, καθώς οι δημοσκοπήσεις έδιναν μεγάλο προβάδισμα στον συνασπισμό Κεντροδεξιάς"
		"το δικαστήριο απέρριψε την προσφυγή του με την οποία ζητούσε να ακυρωθεί η πειθαρχική ποινή"
		"Το γκολ που πέτυχε στις καθυστερήσεις η ομάδα ορθώς ακυρώθηκε ως οφ σάιντ"
		"κάτω από αυτές τις συνθήκες ακύρωσαν την έλευσή τους στην Ελλάδα, που είχε προγραμματιστεί"
		"Πήγα στη δεξίωση της Βραζιλίας (ήταν προγραμματισμένη για το ίδιο βράδυ) αλλά τελικά ακυρώθηκε λόγω του σεισμού"))

