	(has_string "επιστολή_1")
	(%3C%3Chas_ID%3E%3E [e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%AE_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "κείμενο το οποίο αποστέλλεται στον παραλήπτη προκειμένου να τον ενημερώσει για κάτι")
	(has_number [Singular])
	(has_synonym [g-%CE%B3%CF%81%CE%AC%CE%BC%CE%BC%CE%B1_2])
	(is_morphologically_related_to
		[e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%B9%CE%BA%CF%8C%CF%82]
		[e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%BF%CE%B3%CF%81%CE%AC%CF%86%CE%BF%CF%82_1]
		[e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%BF%CE%B3%CF%81%CE%AC%CF%86%CE%BF%CF%82_2]
		[e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CE%BF%CE%B3%CF%81%CE%B1%CF%86%CE%AF%CE%B1]
		[e-%CE%B5%CF%80%CE%B9%CF%83%CF%84%CE%BF%CE%BB%CF%8C%CF%87%CE%B1%CF%81%CF%84%CE%BF])
	(UsageExample
		"Τι αναφέρει στην επιστολή του προς την κυβέρνηση"
		"εστάλη στην Επιτροπή επιστολή με την οποία η κυβέρνηση ενημέρωνε για την πρόθεσή της να εκσυγχρονίσει την ισχύουσα νομοθεσία."
		"Στην απαντητική επιστολή που έφθασε την Παρασκευή στην Εξεταστική Επιτροπή, οι Ελβετοί αναφέρουν ότι η νομοθεσία τους απαγορεύει το άνοιγμα λογαριασμών με απροσδιόριστες κατηγορίες"
		"Ανοιχτή Επιστολή προς την Οικονομική Κοινότητα της Wall Street ώστε «να αρχίσει να σκέπτεται μακροπρόθεσμα"
		"με εντολή του πρωθυπουργού έστειλε προχθές επιστολή στην πρόεδρο της Βουλής με την οποία ζητεί να ορισθεί μια ειδική συνεδρίαση της Επιτροπής Οικονομικών Υποθέσεων για να συζητήσει η κυβέρνηση με όλα τα κόμματα για το ποιες διαρθρωτικές μεταρρυθμίσεις πρέπει να γίνουν"
		"Την επιστολή έλαβε και δημοσίευσε στις 21 Οκτωβρίου 1997 η εφημερίδα «Αθηναϊκή»."
		"Στην επιστολή αυτή ο Χέλμουτ Κολ ζητούσε την προσωπική παρέμβαση του Γάλλου πρωθυπουργού"))

