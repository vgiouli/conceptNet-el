([k-%CE%BA%CE%BB%CE%B5%CE%B9%CE%B4%CE%AF_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "κλειδί_2")
	(%3C%3Chas_ID%3E%3E [k-%CE%BA%CE%BB%CE%B5%CE%B9%CE%B4%CE%AF_2])
	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "ο,τιδήποτε μας βοηθά να φτάσουμε σε ένα επιθυμητό αποτέλεσμα")
	(has_number [Singular])
	(is_morphologically_related_to
		[k-%CE%BA%CE%BB%CE%B5%CE%B9%CE%B4%CE%AF_1]
