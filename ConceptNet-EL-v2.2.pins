	(has_allomorph [e-%CE%B5%CE%BD%CE%BF%CE%B9%CE%BA%CE%B9%CE%AC%CE%B6%CF%89_1])
	(has_gloss "παραχωρώ ακίνητο ή άλλη κινητή περιουσία σε άλλον για να το χρησιμοποιοεί έναντι ενοικίου")
	(has_synonym [e-%CE%B5%CE%BA%CE%BC%CE%B9%CF%83%CE%B8%CF%8E%CE%BD%CF%89])
