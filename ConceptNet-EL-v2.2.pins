	(has_gloss "τονίζω υπόθεση ή γεγονός, κατά τρόπον ώστε να φαίνεται ότι έχει μεγαλύτερη σπουδαιότητα")
	(has_tense [PresentTense])
	(mwe_type LVC)
	(UsageExample
		"Προσφάτως επίσης ο βρετανικός Τύπος έδωσε έκταση στο θέμα μιας οικογενειακής κτηματομεσιτικής επιχείρησης που πούλησε τα 32 γραφεία της στη μεγάλη στεγαστική τράπεζα Nationwide το 1988 έναντι 5 περίπου δισ. δρχ. και τώρα μπαίνει ξανά στην αγορά με την ίδρυση ενός νέου γραφείου."
		"Παραδέχτηκαν μεν στην ΑΕΚ ότι υπάρχει γηπεδικό πρόβλημα, αλλά παράλληλα τονίζουν ότι δόθηκε έκταση στο θέμα.")
	(V_declension V))

