	(has_string "δίψα_1")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%AF%CF%88%CE%B1_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "επιθυμία για νερό")
	(has_number [Singular])
	(instantiates [Concept-%CE%B4%CE%AF%CF%88%CE%B1])
	(is_morphologically_related_to
		[d-%CE%B4%CE%AF%CF%88%CE%B1_2]
		[d-%CE%B4%CE%B9%CF%88%CE%AC%CF%89_1]
		[d-%CE%B4%CE%B9%CF%88%CE%AC%CF%89_2]
		[d-%CE%B4%CE%B9%CF%88%CE%B1%CE%BB%CE%AD%CE%BF%CF%82])
	(UsageExample
		"Σημάδια και συμπτώματα, όπως αυξημένη δίψα και ούρηση, πείνα, απώλεια βάρους, θολή όραση και κόπωση έπονται κάποιας νόσου και συνήθως εμφανίζονται εντός εβδομάδων."
		"Είδε το δίσκο, ανακάθισε στο κρεβάτι, πω πω τι δίψα είχα, κατέβασε το μισό ποτήρι με μια ρουφηξιά, αχ, τι δροσερή που είναι."
		"Λίγο παρακάτω υπήρχε ένα πηγάδι όπου οι βοσκοί πότιζαν τα κοπάδια τους, και πλησίασε να σβήσει τη δίψα του."
		"Άντε, τώρα, πάμε να πιούμε -- πεθαίνω απ' τη δίψα"
		"Περιλαμβάνουν αυξημένη ούρηση, αίσθημα δίψας, απώλεια της όρεξης, ναυτία ή εμετό, υπνηλία ή κούραση, ερυθηματώδη ξηροδερμία, ξηροστομία και αναπνοή με φρουτώδη οσμή."))

