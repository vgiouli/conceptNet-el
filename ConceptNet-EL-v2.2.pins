	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_1])
	(has_case [Nominative])
	(has_gender [Masculine])
	(has_gloss "ονομασία βιβλίου, ταινίας ή άλλου πνευματικού έργου ή τμήματος αυτού")
	(has_number [Singular])
	(instantiates [Concept-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82-%CE%AD%CF%81%CE%B3%CE%BF%CF%85])
	(is_morphologically_related_to
		[t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_2]
		[t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_3]
		[t-%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%8D%CF%87%CE%BF%CF%82]
		[y-%CF%85%CF%80%CE%AD%CF%81%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%82]
		[p-%CF%80%CE%BB%CE%B1%CE%B3%CE%B9%CF%8C%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%82])
	(UsageExample
		"Η ταινία για τον Μιτεράν προεβλήθη χθες, με κοσμοσυρροή, τίτλος της «ο περιπατητής του Πεδίου Άρεως»."
		"«Πράσινος διαφωτισμός» ήταν ο τίτλος άρθρου στο οπισθόφυλλο της έγκυρης «Frankfurter Αllgemeine Ζeitung», με θέμα την εγκυρότητα της ψήφου στη Βόρεια Ρηνανία-Βεστφαλία αρκετών «πράσινων» πολιτών διπλής ιθαγένειας, τουρκικής και γερμανικής, ιδιότητας αντισυνταγματικής στην Ομοσπονδιακή Γερμανία."
		"To έργο (αγγλικός τίτλος The general-ship of Alexander the Great) του υποστράτηγου Fuller πρωτοκυκλοφόρησε το 1960."))

([t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "τίτλος_2")
	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_2])
	(has_case [Nominative])
	(has_gender [Masculine])
	(has_gloss "θέση ή αξίωμα, επίσημος ή ανεπίσημος")
	(has_number [Singular])
	(is_morphologically_related_to
		[t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_1]
		[t-%CF%84%CE%AF%CF%84%CE%BB%CE%BF%CF%82_3]
		[t-%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%8D%CF%87%CE%BF%CF%82]
		[y-%CF%85%CF%80%CE%AD%CF%81%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%82]
		[p-%CF%80%CE%BB%CE%B1%CE%B3%CE%B9%CF%8C%CF%84%CE%B9%CF%84%CE%BB%CE%BF%CF%82])
	(UsageExample
		"Και στα ταχυφαγεία ο τίτλος των υπαλλήλων αναγράφεται σε μια ταμπελίτσα καρφιτσωμένη στο πέτο τους (Kitsa Talaiporou,«employeer of the month)."
		"Τα Penguin το πέτυχαν σε σημείο ώστε να θεωρούνταν τίτλος τιμής για ένα συγγραφέα να περάσει στη λίστα τους."
		"O επίσημος τίτλος τους, εκτός φυσικά από εκείνον του πρεσβευτή καλής θελήσεως, είναι «χρήσιμες προσωπικότητες», δεδομένου ότι πολλές φορές διαθέτουν σημαντικά ποσά (τα οποία εκπίπτουν από την εφορία) για να βοηθήσουν τους δυστυχούντες ανθρώπους και εμμέσως να προβάλουν τον εαυτό τους."
		"Με τον καιρό, φάνηκε πως δεν δόθηκε τυχαία ο τίτλος «στρογγυλή θεά» στην μπάλα."))

