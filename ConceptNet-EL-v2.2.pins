	(has_gender [Neuter])
	(has_gloss "που έχει θετικά και αρνητικά")
	(has_number [Singular])
	(mwe_type fixed)
	(UsageExample
		"η στρατιωτική παρουσία της Συρίας στο Λίβανο είναι δίκοπο μαχαίρι που αρχίζει να στρέφεται περισσότερο εναντίον της Δαμασκού και λιγότερο εναντίον του Ισραήλ και της φιλοδυτικής αντιπολίτευσης."
		"Η φήμη που αποκτά ένας σολίστ είναι δίκοπο μαχαίρι ως προς τη δυνατότητα απομόνωσης και μελέτης;"
		"Σχετικά με την εφαρμογή του νέου ΚΟΚ, ο υπουργός σημείωσε ότι «το υψηλό πρόστιμο είναι δίκοπο μαχαίρι"
		"Αλλά η επιστήμη είναι δίκοπο μαχαίρι μπορεί να χρησιμοποιηθεί και για καλό και για κακό."))

