([f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_1] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "φόρμουλα_1")
	(%3C%3Chas_ID%3E%3E [f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "σύνολο από συστατικά από τα οποία φτιάχνεται κάτι")
	(has_number [Singular])
	(is_morphologically_related_to
		[f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_2]
		[f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_3])
	(UsageExample
		"Αυτή η φόρμουλα άμεσης απόδοσης προσφέρει ορατή βελτίωση στην επιδερμίδα για συνολικά πιο νεανική, σφριγηλή, ανανεωμένη όψη"
		"Στην κυριολεξία, μαγική μελωδία που περιέχει αφορισμούς, ξόρκια και μαγικές φόρμουλες"
		"Το TVC αποκάλυψε τη μυστική φόρμουλα που μπορεί να κάνει τις ρυτίδες να εξαφανιστούν από το πρόσωπο των σταρ"
		"Η συνταγή του διάσημου αναψυκτικού παραμένει ακόμη άγνωστη. Η περίφημη φόρμουλα δημιουργήθηκε από τον φαρμακοποιό John S. Pemberton και αποτελεί ένα από τα μεγαλύτερα εμπορικά μυστικά."
		"Ο Πέμπερτον αντικατέστησε έτσι το κρασί της φόρμουλάς του με εκχύλισμα ζάχαρης και το 1886 ήταν έτοιμος να ρίξει στην αγορά την «Coca-Cola» του, το «ποτό της εγκράτειας» όπως το διαφήμιζε"))

([f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "φόρμουλα_2")
	(%3C%3Chas_ID%3E%3E [f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_2])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "τρόπος ή μέθοδος ενεργειών με στόχο την επίτευξη συγκεκριμένου στόχου")
	(has_number [Singular])
	(is_morphologically_related_to
		[f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_1]
		[f-%CF%86%CF%8C%CF%81%CE%BC%CE%BF%CF%85%CE%BB%CE%B1_3])
	(UsageExample
		"Μάλιστα, τώρα επιζητείται νέα φόρμουλα επιστροφής των δύο μερών σε νέες διαπραγματεύσεις"
		"Η φόρμουλα που εφαρμόζεται τουλάχιστον από το 1999 μέχρι και σήμερα είναι ο χαρακτηρισμός της προσυμφωνημένης απόδοσης ως πιθανή ή ενδεικτική."
		"Αν χρησιμοποιείτε την τουριστική φόρμουλα οργανωμένα ταξίδια, οργανωμένες διακοπές και περιηγήσεις, η ευρωπαϊκή νομοθεσία σας παρέχει ορισμένα δικαιώματα που ισχύουν σε όλες τις χώρες της Ένωσης."
		"Εκείνο που απομένει είναι εξεύρεση μιας φόρμουλας επικοινωνίας και συνεννόησης μεταξύ των δύο υπουργείων, αφού δεν είναι η πρώτη φορά που εγείρονται τέτοιου είδους προβλήματα."
		"βρέθηκε η φόρμουλα για δοθεί και στους κληρικούς το πριμ παραγωγικότητας"
		"η λύση του προβλήματος \"δεν είναι ζήτημα φόρμουλας είναι ένα θέμα πολιτικής απόφασης"))

