	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%BF%CE%BD%CF%8E%CE%BD%CF%89_2])
	(has_gloss "ενισχύω")
	(has_tense [PresentTense])
	(is_morphologically_related_to
		[t-%CF%84%CE%BF%CE%BD%CF%89%CF%84%CE%B9%CE%BA%CF%8C]
		[t-%CF%84%CE%BF%CE%BD%CF%89%CF%84%CE%B9%CE%BA%CF%8C%CF%82])
	(UsageExample
		"Το σημαντικότερο: τονώνονται μικρομεσαίες επιχειρήσεις, αφού το δημόσιο χρήμα μοιράζεται σε περισσότερες τσέπες."
		"Τα μέτρα δημοσιονομικής τόνωσης ή οι δημόσιες δαπάνες είναι πλέον η συνήθης συνταγή που εφαρμόζουν οι κυβερνήσεις για να τονώσουν τις οικονομίες τους."
		"Η ολοκλήρωση και κατάθεση στη Βουλή του νέου θεσμικού πλαισίου αναμένεται να τονώσει περαιτέρω το επενδυτικό κλίμα."
		"Του δίνουμε κουράγιο, τον τονώνουμε τον ενισχύουμε."))

