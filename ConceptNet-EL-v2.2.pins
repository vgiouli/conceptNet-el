	(has_case [Nominative])
	(has_gender [Neuter])
	(has_gloss "οτιδήποτε πυροδοτεί μία ενέργεια")
	(has_number [Singular])
	(instantiates [Concept-%CE%AD%CE%BD%CE%B1%CF%85%CF%83%CE%BC%CE%B1])
	(UsageExample
		"τρεμόπαιζε η κρυφή ελπίδα, μήπως η πολιτική αλλαγή γινόταν έναυσμα ή καταλύτης για κοινωνική αφύπνιση από τον ζοφερό εφιάλτη"
		"ο φόβος θα δώσει το έναυσμα για τη γενικευμένη φυγή επιχειρήσεων του τομέα των υπηρεσιών στα νέα κράτη - μέλη"
		"Η εισαγωγή του μέτρου, τη δεκαετία του 1980, σε συνδυασμό με τη μεταβολή των κοινωνικών και οικονομικών συνθηκών, αποτέλεσε το έναυσμα αγοράς δεύτερου αυτοκινήτου ώστε κάθε ημέρα να υπάρχει διαθέσιμο προς κυκλοφορία όχημα στον δακτύλιο."
		"τα χρέη της προς τράπεζες και προμηθευτές έδωσαν ένα επιπλέον έναυσμα σε Standard and Ρoor’s και Μoody’s για την υποβάθμιση της πιστοληπτικής ικανότητας του ΟTΕ."))

