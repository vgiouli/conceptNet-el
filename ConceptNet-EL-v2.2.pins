	(has_number [Singular])
	(has_synonym
		[d-%CE%B4%CE%B9%CE%B1%CE%BA%CE%B5%CE%BA%CF%81%CE%B9%CE%BC%CE%AD%CE%BD%CE%BF%CF%82]
