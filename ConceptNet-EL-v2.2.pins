	(has_string "mwe-βάζω νερό στο κρασί μου")
	(%3C%3Chas_ID%3E%3E [mwe-%CE%B2%CE%AC%CE%B6%CF%89_%CE%BD%CE%B5%CF%81%CF%8C_%CF%83%CF%84%CE%BF_%CE%BA%CF%81%CE%B1%CF%83%CE%AF_%CE%BC%CE%BF%CF%85])
	(mwe_type VID))

([mwe-%CE%B2%CE%AC%CE%B6%CF%89_%CF%80%CE%BB%CF%8E%CF%81%CE%B7] of  EL-MWE VERB+MW

	(has_string "mwe-βάζω πλώρη")
	(%3C%3Chas_ID%3E%3E [mwe-%CE%B2%CE%AC%CE%B6%CF%89_%CF%80%CE%BB%CF%8E%CF%81%CE%B7])
	(has_gloss "ξεκινώ να πάω κάπου ή να κάνω κάτι")
	(has_tense [PresentTense])
	(mwe_type VID)
	(UsageExample
		"Στοιβάζουν τους λαθρομετανάστες σε μικρά ταχύπλοα και βάζουν πλώρη για κάποια έρημη ακτή των νησιών μας."
		"Με λευκό μπλουζάκι, σπορ εμφάνιση και το καπέλο στο χέρι, κάθισε στο τιμόνι με τον καπετάν Νίκο και έβαλε πλώρη για τους Κοκκινομύτες, έναν ψαρόπαγκο αριστερά, ανοιχτά του λιμανιού."
		"Αφού πήρε όλα τα πιστοποιητικά που της έδωσαν τα κατέθεσε μαζί με το καταστατικό της εταιρείας στο Πρωτοδικείο κι έβαλε πλώρη για την εφορία Αμαρουσίου (όπου η έδρα της επιχείρησης) για να πάρει αριθμό φορολογικού μητρώου."
		"Με το χθεσινοβραδινό 76-64 η «Ένωση» έφτασε το 6-0 κι έβαλε πλώρη για την πρώτη θέση του ομίλου της."
		"Τα περισσότερα ανέφεραν ότι η Βάσω έβαλε πλώρη για να διαδεχθεί τον K. Σημίτη.")
	(V_declension V))

