	(is_morphologically_related_to
		[e-%CE%B5%CE%BE%CE%B5%CF%84%CE%AC%CE%B6%CF%89_2]
		[e-%CE%B5%CE%BE%CE%B5%CF%84%CE%AC%CE%B6%CF%89_3]
