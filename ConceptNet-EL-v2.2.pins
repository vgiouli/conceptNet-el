	(has_number [Singular])
	(is_morphologically_related_to
		[s-%CF%83%CE%B1%CE%BD%CE%AF%CE%B4%CE%B1_2]
		[s-%CF%83%CE%B1%CE%BD%CE%AF%CE%B4%CE%B1_3]
