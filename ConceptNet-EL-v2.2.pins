([p-%CF%80%CF%81%CE%BF%CF%83%CF%84%CE%AC%CE%B6%CF%89_2] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "προστάζω_2")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CF%81%CE%BF%CF%83%CF%84%CE%AC%CE%B6%CF%89_2])
	(has_tense [PresentTense])
	(is_morphologically_related_to
		[p-%CF%80%CF%81%CF%8C%CF%83%CF%84%CE%B1%CE%B3%CE%BC%CE%B1]
		[p-%CF%80%CF%81%CE%BF%CF%83%CF%84%CE%AC%CE%B6%CF%89_1]
		[p-%CF%80%CF%81%CE%BF%CF%83%CF%84%CE%B1%CE%B3%CE%AE_1]
		[p-%CF%80%CF%81%CE%BF%CF%83%CF%84%CE%B1%CE%B3%CE%AE_2])
	(UsageExample
		"Η τελευταία λέξη στα ταξίδια στην Ελλάδα κατά την διάρκεια του καλοκαιριού προστάζει \"Άγονη Γραμμή\"."
		"Απλούστατα το έκανε διότι γνώριζε πολύ καλά ότι έτσι έπρεπε να κάνει, διότι έτσι πρόσταζαν τα συμφέροντα της χώρας."
		"Σήμερα οι μπίτνικ κάνουν και πάλι την εμφάνισή τους στη Νέα Υόρκη, μέσα σε κλαμπ και σε πανεπιστήμια, σύμφωνα με τη μόδα της εποχής που προστάζει την επιστροφή στη δεκαετία του '70."
		"Μίλησε ωστόσο, όπως πρόσταζε το τυπικό, τελευταίος, περιμένοντας μέχρι τότε καθισμένος στην πιο επίσημη πολυθρόνα που βρέθηκε στο χώρο."))

