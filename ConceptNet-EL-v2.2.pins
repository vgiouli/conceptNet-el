		[k-%CE%BA%CE%B1%CF%84%CE%AC%CF%81%CF%81%CE%B5%CF%85%CF%83%CE%B7_2])
	(UsageExample
		"παγιδευμένο με εκρηκτικά όχημα εξερράγη στην είσοδο του υπερπολυτελούς ξενοδοχειακού συγκροτήματος «Γκαζάλα Γκάρντενς», τμήμα του οποίου κατέρρευσε"
		"Σ' ένα νεοκλασικό αρχοντικό που καταρρέει, ζουν ο ξεπεσμένος μεγαλοαστός και η αφοσιωμένη ικονόμος του."))

([k-%CE%BA%CE%B1%CF%84%CE%B1%CF%81%CF%81%CE%AD%CF%89_2] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "καταρρέω_2")
	(%3C%3Chas_ID%3E%3E [k-%CE%BA%CE%B1%CF%84%CE%B1%CF%81%CF%81%CE%AD%CF%89_2])
