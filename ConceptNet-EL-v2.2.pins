([ks-%CE%BE%CE%B5%CF%83%CF%80%CE%AC%CF%89_1] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "ξεσπάω_1")
	(%3C%3Chas_ID%3E%3E [ks-%CE%BE%CE%B5%CF%83%CF%80%CE%AC%CF%89_1])
	(has_gloss "συμβαίνω ξαφνικά και εδκηλώνομαι με έντονο ή βίαιο τρόπο")
	(has_tense [PresentTense])
	(is_morphologically_related_to [ks-%CE%BE%CE%AD%CF%83%CF%80%CE%B1%CF%83%CE%BC%CE%B1])
	(UsageExample
		"Το σκάνδαλο που ξέσπασε και οι έρευνες που ακολούθησαν αφήνουν ελάχιστες αμφιβολίες για το αντίθετο."
		"Ένα μήνα νωρίτερα έχει ξεσπάσει η ιστορία με τον Σορίν Ματέι, έναν κακοποιό, εγκληματία και ό,τι επακαλούθησε."
		"Τα τελευταία 60 χρόνια δεν ξέσπασε τρίτος παγκόσμιος πόλεμος, μόνον απειράριθμοι μικρότεροι, εξαιρετικά φονικοί."
		"Γι' αυτό, πολλά ήταν τα ερωτήματα που δημιουργήθηκαν στους κατοίκους της περιοχής, όταν, στις 14 Σεπτεμβρίου του 2003, ξέσπασε πυρκαγιά στο οικόπεδο"))

([ks-%CE%BE%CE%B5%CF%83%CF%80%CE%AC%CF%89_2] of  EL+GRAPHEME+CONTINUOUS VERB+SINGLE

	(has_string "ξεσπάω_2")
	(%3C%3Chas_ID%3E%3E [ks-%CE%BE%CE%B5%CF%83%CF%80%CE%AC%CF%89_2])
	(has_tense [PresentTense])
	(UsageExample
		"Μερικά ξεσπάνε σε κλάματα (17,5%), ενώ άλλα δεν αντιδρούν καθόλου (13,9%)."
		"O κόσμος άρχισε να χειροκροτά και να με αγκαλιάζει, άλλοι ξέσπασαν σε δάκρυα."))

