		[t-%CF%84%CE%BF%CF%80%CE%BF%CE%B8%CE%AD%CF%84%CE%B7%CF%83%CE%B7_2])
	(UsageExample "Η επίθεση αυτοκτονίας μέλους της ισλαμικής Τζιχάντ στην ισραηλινή πόλη Νετάνια έδωσε την αφορμή για την επανακατάληψη της Τουλκαρέμ από τον ισραηλινό στρατό, την εξόντωση Παλαιστινίων μαχητών (σε ορισμένες περιπτώσεις, όπως στην Τζενίν της Βόρειας Δυτικής Όχθης, ύστερα από πραγματικές, πολύωρες μάχες) και την επιστροφή της «πολεμικής» φρασεολογίας στις τοποθετήσεις των δύο πλευρών."))

([t-%CF%84%CE%BF%CF%80%CE%BF%CE%B8%CE%AD%CF%84%CE%B7%CF%83%CE%B7_4] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "τοποθέτηση_4")
	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%BF%CF%80%CE%BF%CE%B8%CE%AD%CF%84%CE%B7%CF%83%CE%B7_4])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "το αποτέλεσμα του τοποθετούμαι")
	(has_number [Singular])
	(UsageExample
		"Αυτή τη φορά δεν περιορίσθηκε σε αποσπασματικές τοποθετήσεις και σε εκδηλώσεις μεταπολιτικού «λάιφ στάιλ"
		"Δεν χρειάζεται φιλοσοφία για να αντιληφθεί κανείς ότι οποιαδήποτε επαναστάθμιση των ρωσικών θέσεων οδηγεί αναπότρεπτα σε υιοθέτηση τοποθετήσεων εγγύτερων προς τις τουρκικές απόψεις."
		"Οι τουριστικοί επιχειρηματίες αναμένουν με ενδιαφέρον την τοποθέτηση του πρωθυπουργού, ο οποίος έχει δηλώσει επανειλημμένα ότι αντιλαμβάνεται τον τουρισμό σαν δύναμη ανάπτυξης και εργαλείο για την αύξηση της απασχόλησης και στήριξης της Περιφέρειας."))

