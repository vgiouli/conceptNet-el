	(%3C%3Chas_ID%3E%3E [z-%CE%B6%CF%8E%CE%BD%CE%B7_1])
	(CanonicalForm [%CE%B6%CF%8E%CE%BD%CE%B7])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "εξάρτημα ενδυμάτων, συνήθως από δέρμα ή ύφασμα")
	(has_number [Singular])
	(instantiates [Concept-%CE%B6%CF%8E%CE%BD%CE%B7-1])
	(is_morphologically_related_to
		[z-%CE%B6%CF%8E%CE%BD%CE%B7_2]
