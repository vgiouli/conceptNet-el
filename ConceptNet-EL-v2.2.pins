	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%AD%CE%BD%CF%84%CE%B1_1])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "κατασκευή από ύφασμα που προστατεύει από τον ήλιο")
	(has_number [Singular])
	(is_morphologically_related_to [t-%CF%84%CE%AD%CE%BD%CF%84%CE%B1_2])
	(UsageExample
		"Έπιασε αέρας, μάζεψε την τέντα"
		"Από τα σημαντικότερα μειονεκτήματα είναι η λυόμενη κατασκευή και κυρίως η τέντα στην οροφή."
		"Κρατήστε τον ήλιο έξω από το κτίριό σας με κατάλληλη ηλιοπροστασία, δηλαδή με σκίαστρα, κουρτίνες, τέντες πέργκολες πάνω από πόρτες και παράθυρα."
		"Το 1962 σώζει σε τέμπερά του έναν Αθηναϊκό δρόμο, με το εύρημα του μπλε λεωφορείου στις ώχρες, ενώ το ίδιο μπλε δίνει και τον επόμενο χρόνο στις τέντες μπαλκονιών πολυκατοικίας στον Λυκαβηττό, σπάζοντας ανάλογα ωχρούς τόνους."))

([t-%CF%84%CE%AD%CE%BD%CF%84%CE%B1_2] of  EL+GRAPHEME+CONTINUOUS NOUN+SINGLE

	(has_string "τέντα_2")
	(%3C%3Chas_ID%3E%3E [t-%CF%84%CE%AD%CE%BD%CF%84%CE%B1_2])
	(has_case [Nominative])
	(has_gender [Feminine])
	(has_gloss "κατασκευή απόπανί, είδος μεγάλης σκηνής")
	(has_number [Singular])
	(is_morphologically_related_to [t-%CF%84%CE%AD%CE%BD%CF%84%CE%B1_1])
	(UsageExample
		"Δίνοντας συγκεκριμένα στοιχεία για τους αστέγους στα σημεία όπου δραστηριοποιούνται, τα μέλη της μη κυβερνητικής οργάνωσης είχαν καταγράψει μέχρι χθες ως «σκηνίτες» 1.700 άτομα στο Καματερό, 1.200 άτομα στο Ζεφύρι, 11.62 άτομα που μοιράζονται σε 164 σκηνές στην Κάτω Κηφισιά και 400 άτομα που ζουν σε 72 τέντες στις Αδάμες (Νέα Κηφισιά) όπου έχουν στηθεί και τα πρώτα δέκα προκάτ- κοντέινερ."
		"Δεκάδες εθνικές σπεσιαλιτέ, που μαγειρεύονται η κάθε μία κάτω απ' τη δική της τέντα -έχει και feta sandwich- σε σέρνουν απ' τη μύτη, ενώ κάποιο άγνωστο συγκρότημα τζαζ, αλλά συνηθέστερα μπλουζ ή παλιομοδίτικου ροκ, σε σέρνει από τ' αφτί."))

