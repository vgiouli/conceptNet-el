([d-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1_1] of  EL+GRAPHEME+CONTINUOUS ADVERB+SINGLE

	(has_string "δίπλα_1")
	(%3C%3Chas_ID%3E%3E [d-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1_1])
	(has_degree [Base])
	(instantiates [Concept-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1])
	(is_morphologically_related_to
		[d-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1_2]
		[d-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1_3]
		[d-%CE%B4%CE%AF%CF%80%CE%BB%CE%B1_4]
		[d-%CE%B4%CE%B9%CF%80%CE%BB%CE%B1%CE%BD%CF%8C%CF%82])
	(UsageExample
		"θα βρεθούν δίπλα δίπλα ο Βορειοκορεάτης ηγέτης, Κιμ Γιονγκ Ιλ αλλά και ο Αμερικανός πρόεδρος, Τζορτζ Μπους"
		"Και ένα τραπέζι γύρω, πάνω, κάτω, δίπλα από το οποίο διαδραματίζεται ένας κυριολεκτικά λιτός, ανεπιτήδευτος «Μυστικός δείπνος» χορού..."
		"πρέπει επιπλέον να φωνάζεις για να ακουστείς, καθώς την ίδια ώρα 25 άλλα ζευγάρια μιλούν δίπλα σου και μάλιστα με μουσική υπόκρουση!"
		"γλεντοκοπούσαν αμέριμνοι πάνω στα ερείπια και δίπλα στους μαζικούς τάφους"
		"Πιο δίπλα μια αφίσα με έναν νεαρό με τζην, καθισμένο στο πάτωμα, με την πλάτη στον τοίχο και το κεφάλι στα χέρια"
		"Μια μικρή παρηγοριά όποτε φεύγω από την Κρήτη είναι να ταξιδεύω από τα Χανιά με το «Λισσός», ώστε να μπορώ να επισκεφθώ το μαγαζάκι δίπλα στη ρεσεψιόν του πλοίου."
		"Οπου και αν κοίταγα, έβλεπα πεδιάδες, κοιλάδες και πλαγιές με πυρπολημένα σπίτια και δίπλα να ’χουν κτιστεί τα καινούργια με τα παραδοσιακά κεραμίδια"))

