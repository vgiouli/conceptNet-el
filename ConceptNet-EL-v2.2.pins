	(%3C%3Chas_ID%3E%3E [in_vivo])
	(has_degree [Base])
	(has_gloss "σε πραγματικές συνθήκες")
	(has_specific_use
		[RegisterFormal]
		[Term])
	(mwe_type fixed)
	(UsageExample
		"Οι εκθέσεις αυτές αναφέρουν επίσης ότι η έρευνα δεν περιορίστηκε σε επιδημιολογικές μελέτες, αλλά έγιναν και εκτεταμένα εργαστηριακά πειράματα in vivo (σε ζωντανά πειραματόζωα) και in vitro (σε δοκιμαστικό σωλήνα)."
		"Η διαδικασία αυτή που συμβαίνει in vivo μάλλον συμβαίνει και in vitro, αλλά με μικρότερη ταχύτητα"))

