	(has_string "παραβγαίνω_1")
	(%3C%3Chas_ID%3E%3E [p-%CF%80%CE%B1%CF%81%CE%B1%CE%B2%CE%B3%CE%B1%CE%AF%CE%BD%CF%89_1])
	(has_gloss "ανταγωνίζομαι με κπν")
	(has_synonym [a-%CE%B1%CE%BD%CF%84%CE%B1%CE%B3%CF%89%CE%BD%CE%AF%CE%B6%CE%BF%CE%BC%CE%B1%CE%B9])
